{
  "name": "notedown",
  "version": "1.3.0",
  "private": true,
  "description": "Local-first Markdown and HTML notes for Android",
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "dev": "python -m http.server 8765 --directory app/src/main/assets/www",
    "test:e2e": "node tests/e2e.mjs",
    "test:editor": "node tests/editor.mjs",
    "test:store": "node --test tests/store.mjs",
    "test:storage-ui": "node tests/storage-ui.mjs",
    "test:android": "node tests/android.mjs",
    "test:android-features": "node tests/android-features.mjs",
    "test:android-display": "node tests/android-display.mjs",
    "test:display": "node tests/display.mjs",
    "test": "npm run build:editor && npm run test:store && npm run test:e2e && npm run test:editor && npm run test:storage-ui && npm run test:math && npm run test:table && npm run test:math-ui && npm run test:display",
    "test:math": "node tests/math.mjs",
    "test:table": "node tests/table-drag.mjs",
    "test:math-ui": "node tests/math-ui.mjs"
  },
